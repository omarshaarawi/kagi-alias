{
  "manifest_version": 3,
  "name": "Kagi Mail Alias Creator",
  "version": "1.0.0",
  "description": "Quickly create Kagi Mail email aliases",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://kagimail.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "kagi-alias@kagimail.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
